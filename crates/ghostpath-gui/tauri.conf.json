{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostPath VPN",
  "version": "0.1.0",
  "identifier": "com.ghostpath.vpn",
  "build": {
    "frontendDist": "../../UI/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GhostPath VPN",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Network",
    "shortDescription": "Censorship-resistant Linux VPN client",
    "longDescription": "GhostPath VPN client for Linux featuring VLESS/VMess/Trojan, TUN routing, system tray integration, and deep linking."
  }
}
